# Copie ce fichier en .env.local et renseigne tes valeurs (ne jamais commiter .env.local)

# Clé API Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Destinataire des messages du formulaire (par défaut : l'e-mail du profil)
CONTACT_TO_EMAIL=

# Expéditeur : une adresse d'un domaine vérifié sur Resend, ex. "Portfolio <contact@aalexis.fr>"
# Par défaut "Portfolio <onboarding@resend.dev>", qui ne peut envoyer qu'à l'adresse de ton compte Resend
CONTACT_FROM_EMAIL=
